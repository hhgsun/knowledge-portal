    "content": [
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Genel Mimari" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "Knowledge Portal, klasik bir istemci-sunucu mimarisi kullanır: React tabanlı SPA frontend, ASP.NET Core Web API backend ve SQLite veritabanı. Geliştirme ortamında frontend, /api/* isteklerini Vite proxy üzerinden backend'e yönlendirir." }] },
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Backend Teknolojileri" }] },
      { "type": "bulletList", "content": [
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": ".NET 10 / ASP.NET Core:" }, { "type": "text", "text": " REST API, controller tabanlı mimari." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Entity Framework Core + SQLite:" }, { "type": "text", "text": " Migration'lar startup'ta otomatik uygulanır. WAL modu ve busy timeout etkindir." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "SQLite FTS5:" }, { "type": "text", "text": " BM25 sıralamalı fulltext arama için sanal tablo." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Ollama (opsiyonel):" }, { "type": "text", "text": " nomic-embed-text ile embedding üretimi (semantic arama) ve llama3.2 ile RAG yanıtları." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "JWT + API Key:" }, { "type": "text", "text": " Çift kimlik doğrulama mekanizması. RBAC ile yetki kontrolü." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Background service:" }, { "type": "text", "text": " Arama ve embedding indekslemesi arka planda 5 saniyelik periyotlarla batch olarak çalışır." }] }] }
      ]},
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Frontend Teknolojileri" }] },
      { "type": "bulletList", "content": [
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "React 19 + TypeScript:" }, { "type": "text", "text": " Bileşen tabanlı SPA." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Vite 8:" }, { "type": "text", "text": " Geliştirme sunucusu ve build aracı. auth-popup-callback.html multi-page entry olarak build edilir." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Tailwind CSS 4:" }, { "type": "text", "text": " Utility-first stil altyapısı." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "TipTap 3:" }, { "type": "text", "text": " ProseMirror tabanlı zengin metin editörü. Tablolar, görev listeleri, kod blokları (lowlight ile sözdizimi vurgulama), görsel yapıştırma desteklenir." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "React Router 7:" }, { "type": "text", "text": " İstemci tarafı yönlendirme." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "MSAL.js 5:" }, { "type": "text", "text": " Azure AD kimlik doğrulaması (popup + PKCE akışı)." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Lucide Icons + Sonner:" }, { "type": "text", "text": " İkon seti ve toast bildirimleri." }] }] }
      ]},
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Veri Modeli" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "Temel varlıklar ve ilişkileri:" }] },
      { "type": "bulletList", "content": [
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "User:" }, { "type": "text", "text": " Kullanıcılar — rol (admin/editor/viewer), yerel şifre ve/veya Azure Object ID." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Article:" }, { "type": "text", "text": " Makaleler — TipTap JSON içerik, durum, içerik türü, slug, okuma süresi." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "ArticleVersion:" }, { "type": "text", "text": " İçerik değişikliklerinde otomatik oluşturulan versiyonlar." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Tag / ArticleTag:" }, { "type": "text", "text": " Çoktan-çoğa etiket ilişkisi." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Attachment:" }, { "type": "text", "text": " Makale ekleri — fiziksel dosyalar data/uploads/{articleId}/ altında tutulur." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "ArticleVote / Comment:" }, { "type": "text", "text": " Geri bildirim kayıtları." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "ArticleView / SearchLog:" }, { "type": "text", "text": " Analitik için görüntülenme ve arama kayıtları." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "ApiKey:" }, { "type": "text", "text": " kp_ prefix'li anahtarlar — yalnızca hash'i saklanır." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "FeaturedLink:" }, { "type": "text", "text": " Kenar çubuğu öne çıkan bağlantıları." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "LookupValue:" }, { "type": "text", "text": " İçerik türleri gibi yönetilebilir sabit listeler (etiket, renk, ikon, sıralama)." }] }] }
      ]},
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Önemli Tasarım Kararları" }] },
      { "type": "bulletList", "content": [
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "İçerik formatı olarak TipTap JSON:" }, { "type": "text", "text": " HTML yerine yapılandırılmış JSON saklanır. Arama indeksi için düz metin bu JSON'dan çıkarılır." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "SQLite tercihi:" }, { "type": "text", "text": " Sıfır kurulum maliyeti ve FTS5 desteği. Yüksek eşzamanlılık gereken büyük kurulumlarda PostgreSQL'e geçiş önerilir." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Opsiyonel AI katmanı:" }, { "type": "text", "text": " Ollama kapalıyken sistem tamamen çalışır durumda kalır — semantic/hybrid/RAG aramalar devre dışı kalır, fulltext her zaman çalışır." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Deferred upload:" }, { "type": "text", "text": " Dosya ekleri makale kaydedilene kadar sunucuya gönderilmez; silmeler de kaydetme anında uygulanır. Bu, yarım kalmış düzenlemelerin artık dosya bırakmasını önler." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Seed data:" }, { "type": "text", "text": " İlk açılışta backend/SeedData/articles altındaki JSON dosyaları otomatik yüklenir. Portal, kendi dokümantasyonunu içeren makalelerle hazır gelir." }] }] }
      ]},
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Proje Yapısı" }] },
      { "type": "codeBlock", "attrs": { "language": "text" }, "content": [{ "type": "text", "text": "know/\n├── backend/            # ASP.NET Core Web API\n│   ├── Controllers/    # REST endpoint'leri\n│   ├── Services/       # İş mantığı (arama, embedding, istatistik...)\n│   ├── Auth/           # JWT, API key, RBAC\n│   ├── Models/         # Entity'ler ve DTO'lar\n│   ├── Data/           # DbContext, migration, seed\n│   └── SeedData/       # Başlangıç makaleleri (JSON)\n├── frontend/           # React + Vite SPA\n│   └── src/\n│       ├── pages/      # Sayfa bileşenleri\n│       ├── components/ # Paylaşılan bileşenler\n│       └── lib/        # API istemcisi, yardımcılar\n└── data/               # SQLite veritabanı ve uploads (runtime)" }] }
    ]
  }
