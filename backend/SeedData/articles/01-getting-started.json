    "content": [
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Knowledge Portal Nedir?" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "Knowledge Portal, kurumsal bilgi birikimini organize etmek, aramak ve paylaşmak için tasarlanmış modern bir bilgi yönetim platformudur. Ekip üyeleri makaleler oluşturabilir, etiketleyebilir, versiyonlayabilir ve gelişmiş arama yetenekleri (fulltext, semantic, hybrid, RAG) ile içeriklere hızlıca ulaşabilir." }] },
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Temel Özellikler" }] },
      { "type": "bulletList", "content": [
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Zengin İçerik Editörü:" }, { "type": "text", "text": " TipTap tabanlı editör ile başlıklar, listeler, kod blokları, görseller ve tablolar oluşturabilirsiniz." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Gelişmiş Arama:" }, { "type": "text", "text": " FTS5 fulltext, semantic (Ollama embedding), hybrid (RRF) ve RAG (AI yanıtları) arama modları." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Versiyon Kontrolü:" }, { "type": "text", "text": " Her içerik değişikliği otomatik olarak versiyonlanır. Önceki sürümlere geri dönebilirsiniz." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Etiket Sistemi:" }, { "type": "text", "text": " Makaleleri etiketlerle kategorize edin, arama sırasında #etiket sözdizimi ile filtreleyin." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Dosya Ekleri:" }, { "type": "text", "text": " Makalelere resim, PDF, Word ve diğer dosyaları ekleyebilirsiniz. Metin içerikli dosyalar arama indeksine dahil edilir." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Geri Bildirim:" }, { "type": "text", "text": " Makalelere oy verin (faydalı/faydasız) ve yorum bırakın." }] }] }
      ]},
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Sisteme Giriş" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "Sisteme iki farklı yöntemle giriş yapabilirsiniz:" }] },
      { "type": "orderedList", "content": [
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "E-posta ve Şifre:" }, { "type": "text", "text": " Kayıt olurken belirlediğiniz e-posta ve şifre ile giriş yapın." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Azure AD:" }, { "type": "text", "text": " Kurumsal Microsoft hesabınız ile tek tıkla giriş yapın. İlk girişte otomatik hesap oluşturulur." }] }] }
      ]},
      { "type": "paragraph", "content": [{ "type": "text", "text": "İlk kurulumda varsayılan admin hesabı kullanılabilir:" }] },
