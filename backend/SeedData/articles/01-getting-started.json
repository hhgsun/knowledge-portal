      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Roller ve Yetkiler" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "Sistemde üç temel rol bulunur:" }] },
      { "type": "bulletList", "content": [
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Admin:" }, { "type": "text", "text": " Tüm yetkilere sahiptir. Kullanıcı yönetimi, API key yönetimi, herhangi bir makaleyi düzenleme/silme yapabilir." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Editor:" }, { "type": "text", "text": " Makale yayınlama, arşivleme, onaylama, etiket yönetimi ve analitik görüntüleme yetkisine sahiptir." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "Viewer:" }, { "type": "text", "text": " Makale oluşturabilir (taslak/pending), kendi makalelerini düzenleyebilir ve silebilir. Yayınlama yetkisi yoktur." }] }] }
      ]},
