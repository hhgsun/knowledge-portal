{
  "title": "Deployment ve Yapılandırma Rehberi",
  "contentType": "runbook",
  "tags": ["project-knowledge-portal", "deployment", "monitoring"],
  "excerpt": "Knowledge Portal'ın kurulumu, yapılandırması, Docker ile çalıştırılması ve ortam değişkenleri.",
  "status": "published",
  "content": {
    "type": "doc",
    "content": [
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Sistem Gereksinimleri" }] },
      { "type": "bulletList", "content": [
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": ".NET 10 SDK (backend)" }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Node.js 20+ (frontend)" }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "SQLite (veritabanı — otomatik oluşturulur)" }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Ollama (opsiyonel — semantic search ve RAG için)" }] }] }
      ]},
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Yerel Geliştirme" }] },
      { "type": "codeBlock", "attrs": { "language": "bash" }, "content": [{ "type": "text", "text": "# Backend başlatma\ncd backend\ndotnet run\n# → http://localhost:5174\n# → Swagger: http://localhost:5174/swagger\n\n# Frontend başlatma (ayrı terminal)\ncd frontend\nnpm install\nnpm run dev\n# → http://localhost:5173\n# → API proxy: /api/* → localhost:5174" }] },
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Docker ile Çalıştırma" }] },
      { "type": "codeBlock", "attrs": { "language": "bash" }, "content": [{ "type": "text", "text": "# Development ortamı\ndocker-compose -f docker-compose.dev.yml up\n\n# Test ortamı\ndocker-compose -f docker-compose.test.yml up" }] },
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Yapılandırma (appsettings.json)" }] },
      { "type": "heading", "attrs": { "level": 3 }, "content": [{ "type": "text", "text": "JWT Ayarları" }] },
      { "type": "codeBlock", "attrs": { "language": "json" }, "content": [{ "type": "text", "text": "{\n  \"Jwt\": {\n    \"Key\": \"your-secret-key-min-32-chars\",\n    \"Issuer\": \"KnowledgePortal\",\n    \"Audience\": \"KnowledgePortal\",\n    \"ExpiryHours\": 24\n  }\n}" }] },
      { "type": "heading", "attrs": { "level": 3 }, "content": [{ "type": "text", "text": "Rate Limiting" }] },
      { "type": "codeBlock", "attrs": { "language": "json" }, "content": [{ "type": "text", "text": "{\n  \"RateLimiting\": {\n    \"AuthLimit\": 10,\n    \"SearchLimit\": 30\n  }\n}" }] },
      { "type": "heading", "attrs": { "level": 3 }, "content": [{ "type": "text", "text": "Ollama (Opsiyonel)" }] },
      { "type": "codeBlock", "attrs": { "language": "json" }, "content": [{ "type": "text", "text": "{\n  \"Ollama\": {\n    \"Enabled\": true,\n    \"BaseUrl\": \"http://localhost:11434\",\n    \"EmbeddingModel\": \"nomic-embed-text\",\n    \"ChatModel\": \"llama3.2\",\n    \"MinSimilarityScore\": 0.3\n  }\n}" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "Ollama devre dışıyken semantic, hybrid ve RAG arama modları kullanılamaz. Fulltext arama her zaman çalışır." }] },
      { "type": "heading", "attrs": { "level": 3 }, "content": [{ "type": "text", "text": "Dosya Depolama" }] },
      { "type": "codeBlock", "attrs": { "language": "json" }, "content": [{ "type": "text", "text": "{\n  \"FileStorage\": {\n    \"BasePath\": \"../data/uploads\",\n    \"MaxFileSizeMB\": 20,\n    \"MaxFilesPerArticle\": 20\n  }\n}" }] },
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Veritabanı" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "SQLite veritabanı otomatik oluşturulur ve migration'lar startup'ta uygulanır. WAL modu ve busy timeout otomatik olarak etkinleştirilir." }] },
      { "type": "codeBlock", "attrs": { "language": "bash" }, "content": [{ "type": "text", "text": "# Manuel migration uygulama\ncd backend && dotnet ef database update\n\n# Yeni migration oluşturma\ncd backend && dotnet ef migrations add MigrationName" }] },
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Sağlık Kontrolü (Health Check)" }] },
      { "type": "paragraph", "content": [{ "type": "text", "text": "Sistemin çalıştığını doğrulamak için:" }] },
      { "type": "codeBlock", "attrs": { "language": "bash" }, "content": [{ "type": "text", "text": "curl http://localhost:5174/api/health\n# Yanıt: {\"status\": \"healthy\", ...}" }] },
      { "type": "heading", "attrs": { "level": 2 }, "content": [{ "type": "text", "text": "Production Önerileri" }] },
      { "type": "bulletList", "content": [
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "JWT secret key'i güçlü ve uzun tutun (en az 32 karakter)." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "SQLite yerine bir production veritabanı düşünün (büyük ölçekte)." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "HTTPS zorunlu tutun — reverse proxy (nginx) arkasında çalıştırın." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Uploads dizinini kalıcı bir disk'e mount edin (Docker volume)." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rate limit değerlerini trafik paternine göre ayarlayın." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Frontend build çıktısını nginx veya CDN ile sunun." }] }] }
      ]}
    ]
  }
}
