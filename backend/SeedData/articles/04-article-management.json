        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "contentType:" }, { "type": "text", "text": " İçerik türü (reference, how-to, adr, runbook, faq, policy, onboarding)." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "tags:" }, { "type": "text", "text": " Etiket dizisi — ID, isim veya slug kabul eder." }] }] },
