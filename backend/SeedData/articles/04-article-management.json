        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "pending (Onay Bekliyor):" }, { "type": "text", "text": " İnceleme için gönderilmiş makaleler. Editor veya admin onaylayabilir." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "published (Yayında):" }, { "type": "text", "text": " Herkesin görebildiği aktif makaleler. Arama indeksine dahildir." }] }] },
        { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "marks": [{ "type": "bold" }], "text": "archived (Arşivlenmiş):" }, { "type": "text", "text": " Güncelliğini yitirmiş ama silinmemiş makaleler." }] }] }
      ]},
