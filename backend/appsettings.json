{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../data/knowledge.db;Mode=ReadWriteCreate;Cache=Shared"
  },
  "Jwt": {
    "Secret": "KnowledgePortalSuperSecretKeyMinimum32Characters!",
    "Issuer": "KnowledgePortal",
    "Audience": "KnowledgePortal",
    "ExpirationInMinutes": "1440"
  },
  "RateLimiting": {
    "AuthLimit": 10,
    "SearchLimit": 30
  },
  "FileStorage": {
    "BasePath": "../data/uploads",
    "MaxFileSizeMB": 20,
    "AllowedExtensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".pdf", ".md", ".txt", ".docx", ".xlsx", ".yaml", ".json", ".csv", ".svg"],
    "MaxAttachmentsPerArticle": 20
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "llama3.2",
    "Enabled": true,
    "BatchSize": 10,
    "PollingIntervalSeconds": 5,
    "BackoffSeconds": 30,
    "MinSimilarityScore": 0.3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
